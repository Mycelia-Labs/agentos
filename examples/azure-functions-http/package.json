{
  "name": "@rivet-dev/agentos-example-azure-functions-http",
  "version": "0.0.1",
  "private": true,
  "description": "Local-only Azure Functions HTTP example with Zod job request validation.",
  "type": "module",
  "main": "dist/src/functions/*.js",
  "scripts": {
